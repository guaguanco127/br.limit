                                                    }
                                                },
                                                {
                                                    "box": {
                                                        "maxclass": "newobj",
                                                        "text": "in 2 @comment \"Right In (Signal)\"",
                                                        "patching_rect": [ 246.0, 20.0, 191.0, 22.0 ],
                                                        "numoutlets": 1,
                                                        "fontsize": 12.0,
                                                        "outlettype": [ "" ],
